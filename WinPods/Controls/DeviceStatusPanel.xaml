<UserControl x:Class="WinPods.Controls.DeviceStatusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinPods.Controls">
    <!-- DataContext: an AirPodsDevice. Shows battery and where each bud is, then the connection status. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <controls:ConnectionStatusBrushConverter x:Key="ConnectionStatusBrushConverter" />
        <controls:BudLocationBrushConverter x:Key="BudLocationBrushConverter" />

        <Style x:Key="ReadingColumnStyle" TargetType="StackPanel">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="ReadingTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="LocationTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Earbuds: battery on the first line, where each bud is on the second. -->
        <StackPanel Orientation="Horizontal"
                    Visibility="{Binding ShowsEarbudGrid, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel Style="{StaticResource ReadingColumnStyle}">
                <TextBlock Style="{StaticResource ReadingTextStyle}">
                    <Run Text="Left " Foreground="{StaticResource SecondaryTextBrush}" /><Run Text="{Binding LeftBatteryLabel, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding LeftBudLabel}" Style="{StaticResource LocationTextStyle}"
                           Foreground="{Binding LeftBud, Converter={StaticResource BudLocationBrushConverter}}" />
            </StackPanel>
            <StackPanel Style="{StaticResource ReadingColumnStyle}">
                <TextBlock Style="{StaticResource ReadingTextStyle}">
                    <Run Text="Right " Foreground="{StaticResource SecondaryTextBrush}" /><Run Text="{Binding RightBatteryLabel, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding RightBudLabel}" Style="{StaticResource LocationTextStyle}"
                           Foreground="{Binding RightBud, Converter={StaticResource BudLocationBrushConverter}}" />
            </StackPanel>
            <StackPanel Visibility="{Binding HasChargingCase, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Style="{StaticResource ReadingTextStyle}">
                    <Run Text="Case " Foreground="{StaticResource SecondaryTextBrush}" /><Run Text="{Binding CaseBatteryLabel, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Headphones, or nothing read yet: one summary line, plus whether over-ear headphones are worn. -->
        <TextBlock Text="{Binding DetailBatteryLabel}" Style="{StaticResource ReadingTextStyle}" TextWrapping="Wrap"
                   Visibility="{Binding ShowsBatterySummary, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
        <TextBlock Text="{Binding HeadsetWearLabel}" Style="{StaticResource LocationTextStyle}"
                   Foreground="{StaticResource WinPodsGreenBrush}"
                   Visibility="{Binding HasHeadsetWearState, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusBrushConverter}}" />
            <TextBlock Grid.Column="1" Text="{Binding NearbyStatusLabel}" Margin="7,0,0,0" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding NearbyStatusLabel}"
                       Foreground="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusBrushConverter}}" />
        </Grid>
    </StackPanel>
</UserControl>
