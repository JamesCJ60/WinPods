<Application x:Class="WinPods.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="WinPodsGreen">#69D36F</Color>
            <SolidColorBrush x:Key="WinPodsGreenBrush" Color="{StaticResource WinPodsGreen}" />
            <SolidColorBrush x:Key="PanelBrush" Color="#1D1D20" />
            <SolidColorBrush x:Key="PanelHoverBrush" Color="#28282C" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A7A7AE" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
